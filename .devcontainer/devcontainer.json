{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    // Fuer ci/pipeline-beobachten.sh und den Blick auf Actions-Laeufe.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Systempakete fuer das Cover (wie in ci.yml), uv und die Projektabhaengigkeiten.
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libcairo2 fonts-dejavu-core fontconfig && pip install uv && uv sync",
  // Reicht ein auf dem Host gesetztes GH_TOKEN in den Container durch.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  }
}